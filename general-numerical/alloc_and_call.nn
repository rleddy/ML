
/*

prog_ops.load_config("parameters")

<Perceptron2> |-> <Perceptron2>     :: (<Z> DIM,<Z> epochs,<R> learning_rate)
<Perceptron2> |-> <Perceptron2>     :: (<Z> DIM,<Z> epochs,<R> learning_rate,Vect<R> use_weights)

<Perceptron2> .extends <Perceptron> .mixin <Alpha,Beta,Zeta>
//
(DIM, epochs, learning_rate) {
    super(DIM, epochs, learning_rate)
    Vect<R>.O      special_weights = prog_ops.config("weights")
}
.<polymorph>
//
(DIM, epochs, learning_rate, use_weights) {
    super(DIM, epochs, learning_rate)
    Vect<R>.O      special_weights = use_weights
} .methods {

}


let perceptron_recalc1 = .in .dram(<Perceptron2>)(DIM, epochs, learning_rate)
let perceptron_recalc2 = .in .cache(<Perceptron2>)(DIM, epochs, learning_rate)

let perceptron_recalc3 = .in .gpu_share(<Perceptron2>)(DIM, epochs, learning_rate)

let perceptron_recalc4 = .in .stack(<Perceptron2>)(DIM, epochs, learning_rate)

Vect<R> weights = prog_ops.config("weights")

SortedQueue<Perceptron2> my_container;

let perceptron_recalc5 = .in .{my_container}(<Perceptron2>)(DIM, epochs, learning_rate, weights)
let perceptron_recalc6 = .in .{my_container}.front(<Perceptron2>)(DIM, epochs, learning_rate, weights.copy())
let perceptron_recalc7 = .in .{my_container}.back(<Perceptron2>)(DIM, epochs, learning_rate, weights.copy())
let perceptron_recalc7 = .in .{my_container}.insert(<Perceptron2>,compare)(DIM, epochs, learning_rate, weights.copy())

*/


/*
Z<[,)> i = [0,A.M)
<R> alpha = random([0,1.0])
//
<Z> j = random([3,(A.N-4)])
A[i.up{2},j] = alpha    // even positions starting at zero
//
<R> beta = random([0,1.0])
i = 1
A[i.up{2},j] = beta  // odd positions

// ----------------------------------------------

Z<[,)> i = [0,A.M).evens()
Z<[,)> ip1 = [0,A.N).odds()
//
<R> alpha = random([0,1.0])
<Z> j = random([3,(A.N-4)])
A[i.up,j] = alpha    // even positions starting at zero
//
<R> beta = random([0,1.0])
A[ip1.up,j] = beta  // odd positions

// ----------------------------------------------

// no skip required
const <R> alpha = random([0,100]);   // assume offsets are figured
const <Z> fixed_row = random([0,A.M]), fixed_column = random([0,A.N])
//
A[..,fixed_column] *= alpha              // implicit in place map operation
A[..,..] -= A[pivot_row,..]*A[..,fixed_column];
//
A[fixed_row,..] *= -alpha;
//
A[fixed_row,fixed_column] = alpha

*/