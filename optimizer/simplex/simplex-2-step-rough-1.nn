/*
Solve: 
        c .* x        c, x .el <R>^N
Subject to: 
        A .* x < b    x .el <R>^N .& b .el <R>^M
        x >= 0.0
*/


const <R> epsilon = 1.0e-14

<SimplexResult> .extends <Enums>{0} {
    SOLVED,
    UNBOUNDED,
    UNFEASABLE,
    DEGENERATE,
    FEASABLE
}

<Ordering> .extends <Enums>{0} {
    LEQ,
    GEQ,
    EQ
}



<Constraint> |-> <Constraint>   :: (Vect<R> coefs, <Ordering> ord, <R> bound)
//
//
<Constraint> .extends <O> (coefs,ord,bound) {
    //
    .if ( bound < 0 ) {
        bound = -bound
        coefs <- -coefs      // break reference ... don't overwrite argument, causes allocation
        if ( ord != EQ ) {
            ord = (ord == LEQ) ? GEQ : LEQ
        }
    }
    // 
    O.<R>           constant    = bound
    O.<Ordering>    ord         = ord
    O.Vect<R>       coefs       = Vect<>.concat([bound],-coefs)
    //
    <O.Z> slack = 0
    if ( ord != EQ ) {
        O.slack = (ord == LEQ) ? -1 : 1
    }
    //
} .methods {
//
}



<Objective> |-> <Objective>   :: (Vect<R> coefs)
//
<Objective> .extends <Constraint> (coefs) {
    super(coefs, EQ, 0.0)
} .methods {
//
}


<simplex_build> |-> <Matrix<R>,<SimplexResult>> :: (<Objective> objective, List<Contraint> contraints)
//
//
fun simplex_build(objective,contraints) {

    <Z> neg_slack_count = 0
    <Z> pos_slack_count = 0
    <Z> no_slack_count = 0
    .for each ( contraints c ) {
        .if ( c.slack != 0 ) {
            .if ( c.slack < 0 ) {
                neg_slack_count++
            } .else {
                pos_slack_count++
            }
        } .else no_slack_count++
    }

    // Matrix<>.set_alloc_context(a_context)
    
    // if this is allocation to cells, then the book keepers will be eliminated on return, leaving book keeping up to A
    // if this is in RAM, then these will be deleted after A is constructed
    // initially zero rows are created, they are all added in the next loop
    <Z> aritificial_count = no_slack_count + neg_slack_count
    <Z> slack_variabl_count = pos_slack_count + neg_slack_count
    //
    Matrix<R> c_leqs = .in .ephemeral Matrix<R>.make(0,objective.coefs.N + slack_variabl_count)
    Matrix<R> c_geqs = .in .ephemeral Matrix<R>.make(0,objective.coefs.N + slack_variabl_count)
    Matrix<R> c_eqs  = .in .ephemeral Matrix<R>.make(0,objecc_leqstive.coefs.N + slack_variabl_count)
    //
    <Z> N = contraints.coefs.N
    <Z> slack_offset = 1
    .for each ( contraints c ) {
        .if ( c.slack == 0 ) {
            c_eqs.add_row(c.coefs)      // equalities will be assigned artificial variables
        } .else {
            c_leqs.add_row(c.coefs)
            c_leqs[.last,N+slack_offset] = c.slack  // slack column of the objective
            slack_offset++
        }
    }

    Matrix<R> A = Matrix<R>.vstack(c_leqs,c_geqs,c_eqs)

    .if ( c_geqs.M > 0 || c_eqs.M > 0 ) {
        Matrix<R> A_hat = .in .ephemeral Matrix<R>.vstack(A,objective)
        <SimplexResult> state;
        (A_hat,state) = simplex_phase_1(A_hat,neg_slack_count,pos_slack_count,no_slack_count)
        .if ( state !== FEASABLE ) {
            .delete A
            -(-> (.null,state)
        }
        A = A_hat
    }

    :)-> (A,FEASABLE)
}


<simplex_phase_1> |-> <Matrix<R>,<SimplexResult>> :: (Matrix<R> A,<Z> neg_slack_count,<Z> pos_slack_count,<Z> no_slack_count )
//
fun simplex_phase_1(A,neg_slack_count,pos_slack_count,no_slack_count) {
    <Z> i = [0,A.M)
    const <Z> const_col = 0
    Vect<R> aux_z = .in ephemeral Vect<R>(A.N)
    .for up i {
        aux_z += A[i,..]
    }
    aux_z = -aux_z   // negate artificial auxiliary

    Z<[,)> i = [0,aux_z.N)
    Set<Var<Z>> zero_vars = .{ (Var<Z>) | .for up i { .if aux_z[i] == 0.0 .then { Var<Z>.make(i,i) } } }
    Set<Var<Z>> objective_vars = .{ (Var<Z>) | .for up i { .if aux_z[i] != 0.0 .then { Var<Z>.make(i,i) } } }
    //
    Z<[,)> no_slack_offset = [0,(neg_slack_count + pos_slack_count))
    Set<Z> artifical_variables = .{ (Var<Z>) | .for up no_slack_offset { no_slack_offset } }

    Z<[,)> i = [neg_slack_count,(neg_slack_count + pos_slack_count))
    Set<Z> pos_slack_rows = i.to_set()

    .forever {
        <Var<Z>,R> (column,bmax) = (argmax,max)(aux_z.|(objective_vars))
        .if ( bmax < epsilon ) {
            <R> objective_const = aux_z[const_col]
            .if ( objective_const < -epsilon ) { // too big in the wrong directions
                -(-> (.null,UNFEASABLE)
            } .else .if ( objective_const < epsilon ) {  // very close to zero
                .while ( !(artifical_variables.empty()) ) {
                    <Z> row = artifical_variables.extract(1)        // extract ... pull out and remove
                    <Var<Z>,R> (column,bmax) = (argmax,absmax)(A[row,..].|(objective_vars))
                    .if ( bmax > epsilon ) {
                        simplex_exchange(aux_z,A,row,column);
                        // other conditions?
                    }
                }
                .while ( !(pos_slack_rows.empty()) ) {
                    <Z> row = pos_slack_rows.extract(1)             // extract    .forever {
        <Var<Z>,R> (column,bmax) = (argmax,max)(aux_z.|(objective_vars))
        .if ( bmax < epsilon ) {
            <R> objective_const = aux_z[const_col]
            .if ( objective_const < -epsilon ) { // too big in the wrong directions
                -(-> (.null,UNFEASABLE)
            } .else .if ( objective_const < epsilon ) {  // very close to zero
                .while ( !(artifical_variables.empty()) ) {
                    <Z> row = artifical_variables.extract(1)        // extract ... pull out and remove
                    <Var<Z>,R> (column,bmax) = (argmax,absmax)(A[row,..].|(objective_vars))
                    .if ( bmax > epsilon ) {
                        simplex_exchange(aux_z,A,row,column);
                        // other conditions?
                    }
                }
                .while ( !(pos_slack_rows.empty()) ) {
                    <Z> row = pos_slack_rows.extract(1)             // extract ... pull out and remove
                    A[row,..] *= -1
                }
                :)-> (A,FEASABLE)
            }
            <Var<Z>,<SimplexResult>,R> (row,state,bmax) = (argmax,calc_min(*,*))((A[..,const_col],A[..,column])
        } ... pull out and remove
                    A[row,..] *= -1
                }
                :)-> (A,FEASABLE)
            }
            <Var<Z>,<SimplexResult>,R> (row,state,bmax) = (argmax,calc_min(*,*))((A[..,const_col],A[..,column])
        }
        //
        <Z> row = pivot_row_search(A,column)
        simplex_exchange(aux_z,A,row,column);
        // 
        // conditions 
        .if ( row .el pos_slack_rows ) {
            pos_slack_rows \= row
            aux_z[column]++
            A[..,column] *= -1
        }
        //
        objective_vars \= column
        objective_vars += .{ row }
        zero_vars \= row
        zero_vars += .{ column }
        //
    }
}


<calc_min> |-> <<SimplexResult>,<R>,<Z>> :: (Vect<R> column,Vect<R> consts)

fun calc_min(column,consts) {
    <Z> N = consts.N
    Z<[,)> i = [0,N)
    <Z> smallest_count = 0
    <Z> neg_col_count = 0
    <Z> min_i = 0
    <R> min_value = infinity
    .for up i {
        <R> coef = column[i]
        .if ( coef < 0.0 ) { neg_col_count++; .continue }
        <R> cv = consts[i]
        <R> ratio = calc_min_op(cv,coef)
        .if ( ratio < epsilon ) {
            smallest_count++
        }
        if ( ratio < min_value ) {
            min_value = ratio
            min_i = i
        }
    }

    <SimplexResult> state = FEASABLE
    .if (  smallest_count > 1 ) state = DEGENERATE
    .else if ( neg_col_count == N ) state = UNBOUNDED

    :)-> (state,min_value,min_i)
}



fun calc_min_op(const_value,row_coeff) {
    :)-> ( row_coeff < epsilon ) ? 0.0 : const_value/row_coeff
}





<simplex_travel> |-> <Vect<R>,<SimplexResult>,<R>> :: (Matrix<R> A,Vect<Z> columns,<Z> &pivot_column,Vect<Z> z_vars,Vect<Z> slack_vars)
// The final phase of the simplex method
// seeking to make the first column of the matrix 
// the bearer of optimal variable values
//
fun simplex_travel(A, columns, pivot_column, z_vars, slack_vars) {
    <<simplex_travel>|->> optimal = (UNFEASABLE,null,0)        // the type that this method returns 
    .forever {
        .if ( (simplex_column_test(A, 0, columns, pivot_column)).<B> ) {  // one pairs,triples, ... .first synonum for [0] ... .<B> as the first bool
            optimal = (A[..,0],SOLVED,A[0,0])
            break
        } .else {
            <Z> pivot_row = pivot_row_search(A,pivot_column)
            .if ( pivot_row == 0 ) {
                optimal = (UNBOUNDED,null,0)
                break
            } .else {
                pivot_exchange(A,pivot_row,pivot_column)
                swap(z_vars[pivot_column-1],slack_vars[pivot_row-1])
            }
        }
    }
    :)-> optimal
}


<simplex_column_test> |-> <<B>,<R>> :: (Matrix<R> A,<Z> row,Vect<Z> columns, <Z> &pivot_column)
// seek a column that has the 
fun simplex_column_test(A, row, columns, &pivot_column) {
    <B> passed = true
    <R> bmax = 0.0
    .if ( !(columns.empty()) ) {
        <Z> k = columns.start() // iterator interal to vector 
        pivot_column = k        // 
        bmax = A[row,k]   // initial value
        .while ( k = columns.next() ) { // update iterator with call to vector (but if k++ then compile this call)
            let a_rk = A[row,k]         // possible update
            (bmax, pivot_column) = ((a_rk - bmax) > 0.0) ? (a_rk,k) : .no_change   // .no_change -- dont update vars 
        }
        passed = (bmax <= epsilon)
    }
    :)-> (passed,bmax)
}


<simplex_column_fabs_test> |-> <<B>,<R>> :: (Matrix<R> A,<Z> row,Vect<Z> columns, <Z> &pivot_column)
//
fun simplex_column_fabs_test(A, row, columns, pivot_column) {
    <B> passed = true
    <R> bmax = 0.0
    .if ( !(columns.empty()) ) {
        <Z> k = columns.start()
        pivot_column = k
        bmax = A[row,k]   // initial value
        .while ( k = columns.next() ) {
            let a_rk = A[row,k]         // possible update
            (bmax, pivot_column) = (((fabs(a_rk) - fabs(bmax)) > 0.0) ? (a_rk,k) : .no_change
        }
        passed = (bmax <= epsilon)
    }
    :)-> (passed,bmax)
}



<pivot_row_search> |-> <Z> :: (Matrix<R> A,<Z> pivot_column)
//
fun pivot_row_search(A,pivot_column) {
    <Z> row = 0
    <Z> kp = pivot_column + 1
    //
    Z<[,]> i = [1,A.M]
    .for up i ( .with <Z> j = i+1 )  {
        .if ( A[j,kp] < -epsilon ) .break
    }
    //
    .if ( i.beyond_last() ) {    // i > A.M
        :)-> 0
    } .else {
        row = i + 1
        //
        <R> q1 = -A[row,1]/A[row,kp];
        //
        Z<[,]> i = [row,A.M]
        .for up i ( .with <Z> l = i+1 )  {
            .if ( A[j,kp] < -epsilon ) {
                <R> q = -A[l,1]/A[l,kp];
                (row,q1) = (q .< q1) ? (i+1,q) : .no_change
                .<?.else .if ( q1 == q ) {
                    Z<[,]> k = [1,A.N]
                    <R> q0, qp
                    .for up k ( .with <Z> k1 = k + 1 ) {
                        qp = -A[row,k1]/A[row,kp];
                        q0 = -A[l,k1]/A[l,kp];
                        .if (q0 != qp) break;
                    }
                    .if (q0 < qp) row=(i+1);
                }
            }
        }
    }
    //
    :)-> row
}



<pivot_row_search_PY> |-> <Z> :: (Matrix<R> A,<Z> pivot_column)
//
fun pivot_row_search_PY(A,pivot_column) {
    <Z> row = 0
    <Z> kp = pivot_column + 1
    //
    Z<[,]> i = [1,A.M]
    //
    <Z> i_hat = .first up i { <Z> | .with j = i+1; A[j,kp] < -epsilon }
    //
    .if ( i.beyond_last() ) {    // i > A.M
        :)-> 0
    } .else {
        row = i_hat + 1
        //
        <R> q1 = -A[row,1]/A[row,kp];
        //
        Z<[,]> i = [row,A.M]
        .update (row) .by
        .looping up i ( .with <Z> l = i+1 )  {
            .if ( A[j,kp] < -epsilon ) {
                <R> q = -A[l,1]/A[l,kp];
                (row,q1) = (q .< q1) ? (l,q) : .no_change
                .<?.else .if ( q1 == q ) {
                    Z<[,]> k = [1,A.N]
                    <R,R> (q0, qp) = .first up k { <R,R> (q0,qp) | q0 != qp
                                                    .with k1 = k+1
                                                    .where {
                                                        qp = -A[row,k1]/A[row,kp];
                                                        q0 = -A[l,k1]/A[l,kp];
                                                    }
                                                }
                    .if (q0 < qp) row = l;
                }
            }
        }
    }
    //
    :)-> row
}



<pivot_exchange> |-> <> :: (Matrix<R> A,<Z> pivot_row,<Z> pivot_column)
//
fun pivot_exchange(A,pivot_row,pivot_column) {
    //
    const <R> pivot = 1.0/A[pivot_row,pivot_column];   // assume offsets are figured
    Z<[,]> i = [1,A.M]
    Z<[,]> j = [1,A.N]
    //
    .for up i ( .skip pivot_row ) {        // pivot elimination  // reset assumed otherwise say so
        let row_mult = (A[i,pivot_column] *= pivot);
        .for up j ( .skip pivot_column ) {
            A[i,j] -= A[pivot_row,j]*row_mult;
        }
    }
    //
    .for up j ( .skip pivot_column ) {
        A[pivot_row,j] *= -pivot;
    }
    //
    A[pivot_row,pivot_column] = pivot
}




<pivot_exchange_PY> |-> <> :: (Matrix<R> A,<Z> pivot_row,<Z> pivot_column)
//
fun pivot_exchange_PY(A,pivot_row,pivot_column) {
    //
    const <R> pivot = 1.0/A[pivot_row,pivot_column];   // assume offsets are figured
    Z<[,]> i = [1,A.M].skip(pivot_row)
    Z<[,]> j = [1,A.N].skip(pivot_column)
    //
    A[i .up,pivot_column] *= pivot              // implicit in place map operation
    A[i .up,j .up] -= A[pivot_row,j]*A[i,pivot_column];
    //
    A[pivot_row,j .up] *= -pivot;
    //
    A[pivot_row,pivot_column] = pivot
}





