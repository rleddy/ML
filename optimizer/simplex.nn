import numpy as np

def solve_simplex(c, A, b, operators, is_max=True, M=1000.0):
    """
    Solves a Linear Programming problem using the Big-M method.
    
    :param c: 1D array of coefficients for the objective function (size n)
    :param A: 2D array of constraint coefficients (size m x n)
    :param b: 1D array of constraint RHS values (size m)
    :param operators: List of strings, e.g., ['<=', '>=', '=']
    :param is_max: Boolean, True for maximization, False for minimization
    :param M: Float, representing the arbitrarily large penalty for artificial variables
    :return: Dictionary containing status, optimal variables, and optimal value
    """
    c = np.array(c, dtype=float)
    A = np.array(A, dtype=float)
    b = np.array(b, dtype=float)
    m, n = A.shape
    
    # 1. Convert to Maximization and ensure b >= 0
    if not is_max:
        c = -c
    for i in range(m):
        if b[i] < 0:
            b[i] = -b[i]
            A[i] = -A[i]
            if operators[i] == '<=': operators[i] = '>='
            elif operators[i] == '>=': operators[i] = '=':
            # Surplus variable (-s) and Artificial variable (+a)
            col1 = np.zeros((m, 1)); col1[i, 0] = -1
            col2 = np.zeros((m, 1)); col2[i, 0] = 1
            constraint_matrix = np.hstack([constraint_matrix, col1, col2])
            tableau_c = np.append(tableau_c, [0, -M if is_max else M])
            artif_vars.append(constraint_matrix.shape[1] - 1)
        elif operators[i] == '=':
            # Artificial variable (+a)
            col = np.zeros((m, 1)); col[i, 0] = 1
            constraint_matrix = np.hstack([constraint_matrix, col])
            tableau_c = np.append(tableau_c, -M if is_max else M)
            artif_vars.append(constraint_matrix.shape[1] - 1)

    # Build final tableau
    tableau = np.hstack([constraint_matrix, b.reshape(-1, 1)])
    c_row = np.hstack([tableau_c, 0])
    
    # Update cost row to eliminate -M/M of artificial variables from the objective function
    for idx in artif_vars:
        c_row -= (c_row[idx] * tableau[list(constraint_matrix[:, idx]).index(1), :])

    tableau = np.vstack([tableau, c_row])

    # 3. Simplex Iterations
    while True:
        last_row = tableau[-1, :-1]
        
        # Check optimal condition
        if (is_max and np.all(last_row <= 1e-9)) or (not is_max and np.all(last_row >= -1e-9)):
            break
            
        # Entering variable
        if is_max:
            j = np.argmin(last_row) # Most negative
        else:
            j = np.argmax(last_row) # Most positive
            
        if tableau[-1, j] >= -1e-9 and is_max: break
        if tableau[-1, j] <= 1e-9 and not is_max: break

        # Minimum ratio test for leaving variable
        ratios = []
        for i in range(m):
            val = tableau[i, j]
            if val > 1e-9:
                ratios.append(tableau[i, -1] / val)
            else:
                ratios.append(np.inf)
                
        if np.all(np.array(ratios) == np.inf):
            return {"status": "Unbounded"}

        i = np.argmin(ratios)
        
        # Pivot
        pivot = tableau[i, j]
        tableau[i, :] /= pivot
        for k in range(tableau.shape[0]):
            if k != i:
                tableau[k, :] -= tableau[k, j] * tableau[i, :]

    # 4. Extract Results
    opt_val = tableau[-1, -1]
    if not is_max: opt_val = -opt_val
    
    vars_res = np.zeros(n)
    for col in range(n):
        col_vec = tableau[:-1, col]
        if np.sum(col_vec) == 1 and np.count_nonzero(col_vec) == 1:
            row_idx = np.where(col_vec == 1)[0][0]
            vars_res[col] = tableau[row_idx, -1]

    # Sanity check: ensure artificial variables are driven to zero
    for idx in artif_vars:
        col_vec = tableau[:-1, idx]
        if np.sum(col_vec) == 1 and np.count_nonzero(col_vec) == 1:
            row_idx = np.where(col_vec == 1)[0][0]
            if tableau[row_idx, -1] > 1e-6:
                return {"status": "Infeasible"}

    return {"status": "Optimal", "optimal_values": vars_res, "optimal_objective": opt_val}



// INTERIOR POINT

import numpy as np

def interior_point_lp(c, A, b, max_iter=100, tol=1e-6):
    """
    Solves the linear programming problem:
        min c^T x  s.t.  A x = b, x >= 0
    Using a Primal-Dual Interior Point Method.
    """
    m, n = A.shape
    
    # 1. Initialize variables strictly inside the interior (x > 0, s > 0)
    x = np.ones(n)
    y = np.zeros(m)
    s = np.ones(n)
    
    for i in range(max_iter):
        # Compute residuals
        rp = b - A @ x                     # Primal residual
        rd = c - A.T @ y - s               # Dual residual
        rc = x * s                         # Complementary slackness
        
        # Calculate duality gap and barrier parameter mu
        duality_gap = np.dot(x, s) / n
        if np.linalg.norm(rp) < tol and np.linalg.norm(rd) < tol and duality_gap < tol:
            print(f"Converged in {i} iterations.")
            return x, y, s
            
        # Target a reduced duality gap parameter (centering parameter)
        sigma = 0.1
        mu = sigma * duality_gap
        
        # 2. Formulate the KKT (Newton) system matrix
        # Matrix form: 
        # [  A      0      0  ] [dx]   [rp]
        # [  0     A^T     I  ] [dy] = [rd]
        # [  S      0      X  ] [ds]   [mu*e - X*S*e]
        
        X = np.diag(x)
        S = np.diag(s)
        
        # Build block matrix rows
        row1 = np.block([A, np.zeros((m, m)), np.zeros((m, n))])
        row2 = np.block([np.zeros((n, n)), A.T, np.eye(n)])
        row3 = np.block([S, np.zeros((n, m)), X])
        
        KKT_matrix = np.block([[row1], [row2], [row3]])
        KKT_rhs = np.concatenate([rp, rd, mu * np.ones(n) - rc])
        
        # 3. Solve for the search directions
        delta = np.linalg.solve(KKT_matrix, KKT_rhs)
        dx = delta[0:n]
        dy = delta[n:n+m]
        ds = delta[n+m:]
        
        # 4. Step size control (ratio test to keep variables strictly positive)
        alpha_p = 1.0
        alpha_d = 1.0
        
        # Primal step restriction
        idx_p = np.where(dx < 0)[0]
        if len(idx_p) > 0:
            alpha_p = 0.99 * np.min(-x[idx_p] / dx[idx_p])
            
        # Dual step restriction
        idx_d = np.where(ds < 0)[0]
        if len(idx_d) > 0:
            alpha_d = 0.99 * np.min(-s[idx_d] / ds[idx_d])
            
        # 5. Update iterates
        x = x + alpha_p * dx
        y = y + alpha_d * dy
        s = s + alpha_d * ds

    print("Reached maximum iterations without total convergence.")
    return x, y, s

# --- Example Usage ---
if __name__ == "__main__":
    # Minimize: -2x1 - 3x2
    # Subject to: 
    #   1x1 + 2x2 + x3     = 4  (x3 is slack variable)
    #   1x1 + 1x2      + x4 = 3  (x4 is slack variable)
    
    c = np.array([-2.0, -3.0, 0.0, 0.0])
    A = np.array([
        [1.0, 2.0, 1.0, 0.0],
        [1.0, 1.0, 0.0, 1.0]
    ])
    b = np.array([4.0, 3.0])
    
    x_opt, y_opt, s_opt = interior_point_lp(c, A, b)
    print("Optimal Primal x:", np.round(x_opt, 4))

*/